{
  "name": "Morphologie contour",
  "version": "1.1",
  "context": "morphologie_contour",
  "description": "Fort contraste os/fond + unsharp pour segmentation rapide des contours osseux",
  "category": "bone",
  "execution": {"use_gpu": false},
  "filters": [
    {"name": "window_level", "enabled": true, "params": {"window": 1400.0, "level": 1300.0, "apply_to_pixels": true}},
    {"name": "gamma", "enabled": true, "params": {"gamma": 1.4}},
    {"name": "unsharp", "enabled": true, "params": {"strength": 2.0, "radius": 4}}
  ]
}
