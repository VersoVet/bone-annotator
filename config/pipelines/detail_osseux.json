{
  "name": "Detail osseux",
  "version": "2.0",
  "context": "detail_osseux",
  "description": "Detourage auto + contraste intra-osseux fin pour annotation cortex, trabecule, canal medullaire",
  "category": "bone",
  "execution": {"use_gpu": false},
  "filters": [
    {"name": "auto_bone_mask", "enabled": true, "params": {"method": "otsu", "kernel_size": 15, "padding_percent": 15, "background": "white", "invert": true, "min_area_ratio": 0.05, "mask_dilate": 30}},
    {"name": "window_level", "enabled": true, "params": {"window": 3200.0, "level": 1500.0, "apply_to_pixels": true}},
    {"name": "bilateral_denoise", "enabled": true, "params": {"diameter": 5, "sigma_color": 40, "sigma_space": 40}},
    {"name": "clahe", "enabled": true, "params": {"clip_limit": 3.5, "grid_size": 8}},
    {"name": "unsharp", "enabled": true, "params": {"strength": 1.2, "radius": 2}}
  ]
}
